// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    //// Replace this comment with your code.
   Register(in=next, load=true, out=out, out=curr);
   Inc16(in=curr, out=incOut);
   Mux16(a=curr, b=incOut, sel=inc, out=incOrStay);
   Mux16(a=incOrStay, b=in, sel=load, out=loadOrInc);
   Mux16(a=loadOrInc, b=false, sel=reset, out=next);
}
